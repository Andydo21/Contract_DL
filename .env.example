# Django / PostgreSQL
SECRET_KEY=change-me
DEBUG=True
# Every anonymous visitor becomes a superuser. Never enable while start_online.cmd is exposing the site.
DEMO_AUTO_LOGIN=False
ALLOWED_HOSTS=127.0.0.1,localhost
DB_NAME=contract_db
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=55432
DB_SSLMODE=disable

# Legacy custom Qwen service only. The dual notebook below uses VLLM_BASE_URL.
KAGGLE_QWEN_SERVICE_URL=

# Both URLs come from the same public gateway printed by
# the Qwen/ColPali serving notebook on Kaggle.
VLLM_BASE_URL=https://your-dual-gateway.ngrok-free.app/v1
COLPALI_BASE_URL=https://your-dual-gateway.ngrok-free.app/colpali
# Extraction defers ColPali by default. Enable the endpoint for the later
# reindex_contract_versions --colpali-only job and visual retrieval.
QWEN_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct-AWQ
QWEN_ANSWER_MAX_TOKENS=8192
QWEN_ANSWER_MAX_CLAIMS=96
QWEN_REQUEST_TIMEOUT=600
QWEN_VERIFY_TIMEOUT=180
A2_ANSWER_SOURCE_LIMIT=24
# Set in the Kaggle model cell, not just the web: QWEN_MAX_MODEL_LEN=32768.

# Recommended when Contract_DL and PlanA run at the same time. Native Windows:
# http://localhost:6333. From a Docker web container: http://host.docker.internal:6333.
# If blank, Contract_DL opens ai_extract/a3/qdrant_storage directly; only one
# process may own that embedded storage directory at a time.
QDRANT_URL=
QDRANT_API_KEY=

# BGE-M3 dense branch
DENSE_EMBEDDING_MODEL=BAAI/bge-m3

# Extraction-time passage links (retrieval hints for the final LLM).
A3_RELATED_PASSAGES_ENABLED=True
A3_RELATED_PASSAGE_CANDIDATES=5
A3_RELATED_PASSAGE_LIMIT=2
A3_RELATED_PASSAGE_MIN_LOGIT=0
HF_TOKEN=

# The Docker Compose local overlay runs A3 inference on the local GPU.
# Existing Hugging Face checkpoints can be reused from this host directory.
A3_HF_CACHE_DIR=D:/hf_cache
# Body text reader inside Surya layout blocks: surya or vietocr. Tables and figures always use Surya.
OCR_TEXT_ENGINE=auto
# Local model checkpoints mounted into a3-inference.
A3_MODELS_DIR=D:/Django_project/models/a3
RAG_INFERENCE_URL=http://a3-inference:8010
SURYA_PAGE_READ_TIMEOUT=0
A3_ENTITY_PROVIDER=gliner
GLINER_ENTITY_THRESHOLD=0.5
A3_DOCKER_LOG_CONTAINER=riskdl_web
GLINER_RELATION_THRESHOLD=0.8
# Small offline NLI checkpoint used by relation source-support review.
NLI_MODEL_PATH=scratch/a3-models/nli-deberta-v3-xsmall

# Contract summary service (ai_summary). Blank SUMMARY_LLM_URL / SUMMARY_MODEL_ID = the shared gateway above
# (VLLM_BASE_URL / QWEN_MODEL_ID). Set both only to run the dedicated summary model
# (ai_summary/kaggle_notebook.py prints them), e.g. SUMMARY_MODEL_ID=phamthanhfd/contract-summary-qwen3-1.7b
AI_SUMMARY_URL=http://localhost:8004
SUMMARY_LLM_URL=
SUMMARY_MODEL_ID=
SUMMARY_PARALLEL=2
# 1 = summarize every uploaded file in the background (independent of extraction). Changing the model redoes
# every stored summary, so turn it on after a few contracts look right.
AI_SUMMARY_AUTO=0
AI_SUMMARY_AUTO_PARALLEL=1
